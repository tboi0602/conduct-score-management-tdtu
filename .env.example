# ============================================================
# Barcode Attendance System - Environment Configuration
# Copy to .env and adjust per environment.
# ============================================================

# ---------- General ----------
NODE_ENV=development
API_PORT=3000
WORKER_REPLICAS=2
# Worker exposes /health + /metrics for Compose healthcheck & Prometheus.
WORKER_HEALTH_PORT=9101
LOG_LEVEL=info

# ---------- PostgreSQL ----------
POSTGRES_DB=attendance_db
POSTGRES_USER=attendance
POSTGRES_PASSWORD=attendance_secret
POSTGRES_PORT=5432
DATABASE_URL=postgresql://attendance:attendance_secret@postgres:5432/attendance_db?schema=public&pool_timeout=10&connection_limit=15

# ---------- Redis ----------
# Password is enforced via --requirepass in docker-compose.yml.
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@redis:6379
REDIS_PORT=6379
REDIS_IDEMPOTENCY_TTL=86400
REDIS_LOCK_TTL_MS=1000
REDIS_CACHE_TTL=300
REDIS_RATE_LIMIT_WINDOW=10
REDIS_RATE_LIMIT_MAX=10

# ---------- RabbitMQ ----------
# Topology (queues, DLX, retry queues) is asserted by the app on boot.
RABBITMQ_URL=amqp://attendance:mq_secret@rabbitmq:5672
RABBITMQ_USER=attendance
RABBITMQ_PASSWORD=mq_secret
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_EXCHANGE=attendance.events
RABBITMQ_PREFETCH=20
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRIES=10

# ---------- Nginx ----------
NGINX_PORT=80
NGINX_TLS_PORT=443

# ---------- Client (Next.js) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost/api
NEXT_PUBLIC_APP_URL=http://localhost

# ---------- Geofencing ----------
# Max acceptable radius deviation (meters) from event center.
GEOFENCE_MAX_DISTANCE_METERS=500
# Max GPS accuracy allowed for a scan (meters).
GEOFENCE_MAX_GPS_ERROR_METERS=50

# ---------- Rule Engine ----------
# Absences in a row that trigger a warning before auto-warning.
RULE_ABSENT_STREAK_WARN=2
# Absence threshold % over a semester before critical warning.
RULE_ABSENCE_RATE_WARN_PCT=20

# ---------- JWT (auth for admin/counselor dashboards) ----------
# REQUIRED in production - the API refuses to boot without it.
JWT_SECRET=change_me_to_a_long_random_rs256_signing_secret
JWT_EXPIRES_IN=8h

# ---------- Observability ----------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
