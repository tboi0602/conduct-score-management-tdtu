# Copy this file to .env.docker before running Docker Compose.
NODE_ENV=production
API_PORT=3000
WORKER_REPLICAS=2
WORKER_HEALTH_PORT=9101
LOG_LEVEL=info
DB_CONNECTION_LIMIT=20
DB_POOL_TIMEOUT=10

POSTGRES_DB=conduct_score
POSTGRES_USER=conduct_score
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://conduct_score:replace_with_a_strong_password@postgres:5432/conduct_score?schema=public

REDIS_PASSWORD=replace_with_a_strong_password
REDIS_PORT=6379
REDIS_URL=redis://:replace_with_a_strong_password@redis:6379
REDIS_IDEMPOTENCY_TTL=86400
REDIS_LOCK_TTL_MS=1000
REDIS_CACHE_TTL=300
REDIS_RATE_LIMIT_WINDOW=10
REDIS_RATE_LIMIT_MAX=10

EVENT_REGISTRATION_RATE_LIMIT_MAX=6
EVENT_REGISTRATION_RATE_LIMIT_WINDOW=10
ATTENDANCE_QR_SECRET=replace_with_a_long_random_secret
ATTENDANCE_SSE_TICKET_TTL_SECONDS=60
ATTENDANCE_RATE_LIMIT_WINDOW=10
ATTENDANCE_STUDENT_RATE_LIMIT_MAX=6
ATTENDANCE_MANAGER_RATE_LIMIT_MAX=60
ATTENDANCE_ORGANIZER_MAX_GPS_ERROR_METERS=500

RABBITMQ_USER=conduct_score
RABBITMQ_PASSWORD=replace_with_a_strong_password
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://conduct_score:replace_with_a_strong_password@rabbitmq:5672/
RABBITMQ_EXCHANGE=conduct-score.events
RABBITMQ_PREFETCH=20
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRIES=10

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
AWS_REGION=ap-southeast-1
AWS_S3_APPEAL_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
APPEAL_CLEANUP_INTERVAL_MS=3600000
CONDUCT_SCORE_EVENT_SYNC_INTERVAL_MS=30000
WARNING_MAINTENANCE_INTERVAL_MS=86400000

NEXT_PUBLIC_API_BASE_URL=http://localhost
NEXT_PUBLIC_APP_URL=http://localhost
NGINX_PORT=80
NGINX_TLS_PORT=443

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_password
ATTENDANCE_TEST_WORKERS=3
