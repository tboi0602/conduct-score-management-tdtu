{
  "name": "conduct-score-server",
  "version": "1.0.0",
  "private": true,
  "description": "TDTU Conduct Score Management System - API Producer + Worker Consumer",
  "prisma": {
    "schema": "prisma/schema",
    "seed": "tsx prisma/seeds/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json && tsc-alias",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:local": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seeds/index.ts",
    "seed:local": "tsx prisma/seeds/index.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"tests/**/*.{ts,js}\" \"vitest.config.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/**/*.ts\" \"tests/**/*.{ts,js}\" \"vitest.config.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "build:check": "node scripts/build-check.mjs",
    "test": "vitest run",
    "test:attendance": "vitest run tests/attendance",
    "test:attendance:junit": "vitest run tests/attendance --exclude tests/attendance/integration/** --reporter=junit --outputFile=tests/.artifacts/attendance-functional-junit.xml",
    "test:attendance:integration": "vitest run tests/attendance/integration --reporter=junit --outputFile=tests/.artifacts/attendance-integration-junit.xml",
    "test:attendance:prepare": "node scripts/run-tsx.mjs tests/attendance/load/prepare-load-fixture.ts",
    "test:attendance:verify": "node scripts/run-tsx.mjs tests/attendance/load/verify-load-result.ts",
    "test:attendance:artifacts": "node scripts/run-tsx.mjs tests/attendance/load/generate-report.ts",
    "test:attendance:load:qr": "k6 run tests/attendance/load/qr-1000.js",
    "test:attendance:load:barcode": "k6 run tests/attendance/load/barcode-parallel.js",
    "test:attendance-load": "tsx tests/attendance-load.ts",
    "verify": "npm run format:check && npm run typecheck && npm run test && npm run build:check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-presigned-post": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@prisma/client": "^5.16.0",
    "amqplib": "^0.10.4",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.16.0",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.17.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/sanitize-html": "^2.16.1",
    "docx": "^9.8.1",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
