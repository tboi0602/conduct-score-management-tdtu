// ============================================================
// Nhóm: học kỳ & điểm rèn luyện
// ============================================================

// Học kỳ trong năm
enum SemesterType {
  HK1
  HK2
  HK3 // học kỳ hè
}

// Xếp loại điểm rèn luyện: Xuất sắc, Tốt, Khá...
enum Ranking {
  EXCELLENT
  GOOD
  FAIR
  AVERAGE
  POOR
}

// Trạng thái chốt điểm: nháp hay đã duyệt
enum TrainingPointStatus {
  DRAFT
  FINAL
}

// Học kỳ: vd năm 2026 - HK1
model Semester {
  id             String          @id @default(uuid()) @db.Uuid
  year           Int
  type           SemesterType
  events         Event[]
  trainingPoints TrainingPoint[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Một năm không có hai học kỳ trùng loại
  @@unique([year, type])
  @@map("semesters")
}

// Báo cáo / chốt điểm rèn luyện của sinh viên theo kỳ.
// Mỗi sinh viên chỉ có 1 bản ghi tổng kết mỗi kỳ.
model TrainingPoint {
  id         String              @id @default(uuid()) @db.Uuid
  studentId  String              @db.Uuid
  semesterId String              @db.Uuid
  totalPoint Int                 @default(0)
  ranking    Ranking             @default(AVERAGE)
  status     TrainingPointStatus @default(DRAFT)

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester  Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, semesterId])
  @@index([semesterId])
  @@map("training_points")
}
