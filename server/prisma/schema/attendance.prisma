enum AttendanceStatus {
  ATTENDED // đã tham gia
  ABSENT // vắng
  LATE // đi muộn
}

// Chiều điểm danh: sự kiện check-in 2 chiều
enum AttendanceDirection {
  CHECK_IN // quét ở đầu sự kiện
  CHECK_OUT // quét ở cuối sự kiện
}

enum AttendanceSessionStatus {
  OPEN
  CLOSED
}

enum AttendanceScanStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AttendanceScanSource {
  STUDENT_QR
  STAFF_BARCODE
  MANUAL_ENTRY
  BULK_IMPORT
}

// Nhật ký điểm danh: MỖI LƯỢT QUÉT là một bản ghi, phân biệt chiều
// bằng `direction`. Một sinh viên chỉ quét 1 lần mỗi chiều mỗi sự kiện
// (unique gồm cả direction). Giờ check-out thực tế = timeChecking của
// bản ghi có direction = CHECK_OUT.
// points_earned ghi nhận số điểm thực nhận được (có thể bị trừ khi đi muộn...).
model AttendanceRecord {
  id            String              @id @default(uuid()) @db.Uuid
  studentId     String              @db.Uuid
  eventId       String              @db.Uuid
  direction     AttendanceDirection @default(CHECK_IN)
  timeChecking  DateTime?
  status        AttendanceStatus    @default(ATTENDED)
  pointsEarned  Int                 @default(0)
  scanRequestId String?             @unique @db.Uuid

  student     Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  event       Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scanRequest AttendanceScanRequest? @relation(fields: [scanRequestId], references: [id], onDelete: SetNull)
  createdAt   DateTime               @default(now())

  // Chặn quét trùng cùng chiều: vào 1 lần, ra 1 lần
  @@unique([studentId, eventId, direction])
  @@index([eventId])
  @@map("attendance_records")
}

model AttendanceSession {
  id                   String                  @id @default(uuid()) @db.Uuid
  eventId              String                  @db.Uuid
  direction            AttendanceDirection
  status               AttendanceSessionStatus @default(OPEN)
  centerLatitude       Float
  centerLongitude      Float
  centerAccuracyMeters Float
  radiusMeters         Int
  openedByUserId       String                  @db.Uuid
  closedByUserId       String?                 @db.Uuid
  openedAt             DateTime                @default(now())
  closedAt             DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  event        Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  openedBy     User                    @relation("AttendanceSessionOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedBy     User?                   @relation("AttendanceSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  scanRequests AttendanceScanRequest[]

  @@index([eventId, status, openedAt, id])
  @@index([openedByUserId, openedAt])
  @@map("attendance_sessions")
}

model AttendanceScanRequest {
  id                String               @id @default(uuid()) @db.Uuid
  clientAttemptId   String?              @unique @db.Uuid
  eventId           String               @db.Uuid
  sessionId         String?              @db.Uuid
  studentId         String               @db.Uuid
  submittedByUserId String               @db.Uuid
  direction         AttendanceDirection
  source            AttendanceScanSource
  requestedStatus   AttendanceStatus     @default(ATTENDED)
  latitude          Float?
  longitude         Float?
  accuracyMeters    Float?
  status            AttendanceScanStatus @default(PENDING)
  rejectionReason   String?              @db.VarChar(100)
  correlationId     String               @unique @db.Uuid
  processedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session          AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  student          Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submittedBy      User               @relation("AttendanceScanSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  attendanceRecord AttendanceRecord?

  @@index([eventId, status, createdAt, id])
  @@index([studentId, status, createdAt, id])
  @@index([sessionId, createdAt, id])
  @@map("attendance_scan_requests")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @db.VarChar(50)
  aggregateId   String    @db.Uuid
  eventType     String    @db.VarChar(100)
  payload       Json
  correlationId String    @db.Uuid
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  publishedAt   DateTime?
  lastError     String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([publishedAt, nextAttemptAt, createdAt, id])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}

enum AttendanceIncidentStatus {
  OPEN
  RESOLVED
}

model AttendanceClientIncident {
  id                 String                   @id @default(uuid()) @db.Uuid
  clientAttemptId    String                   @unique @db.Uuid
  studentId          String                   @db.Uuid
  eventId            String                   @db.Uuid
  direction          AttendanceDirection?
  failureCategory    AttendanceFailureCategory
  failedAt           DateTime
  latitude           Float?
  longitude          Float?
  accuracyMeters     Float?
  tokenFingerprint   String?                  @db.VarChar(64)
  clientOnline       Boolean
  userAgent          String?                  @db.VarChar(500)
  payload            Json
  digest             String                   @db.VarChar(64)
  status             AttendanceIncidentStatus @default(OPEN)
  resolutionNote     String?                  @db.VarChar(1000)
  resolvedByUserId   String?                  @db.Uuid
  resolvedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  resolvedBy User?   @relation("AttendanceIncidentResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, status, failedAt, id])
  @@index([studentId, failedAt, id])
  @@map("attendance_client_incidents")
}

model AttendanceAccessAudit {
  id              String    @id @default(uuid()) @db.Uuid
  requestId       String    @unique @db.VarChar(100)
  clientAttemptId String?   @db.Uuid
  userId          String?   @db.Uuid
  studentId       String?   @db.Uuid
  eventId         String?   @db.Uuid
  method          String    @db.VarChar(10)
  path            String    @db.VarChar(255)
  statusCode      Int
  durationMs      Int
  instance        String    @db.VarChar(100)
  createdAt       DateTime  @default(now())

  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  event   Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt, id])
  @@index([clientAttemptId, createdAt])
  @@index([userId, createdAt])
  @@map("attendance_access_audits")
}
