// Hồ sơ sinh viên, liên kết 1-1 với tài khoản User
model Student {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  classId     String?   @db.Uuid
  studentCode String    @unique @db.VarChar(20) // MSSV
  phone       String?   @db.VarChar(20)
  address     String?   @db.VarChar(255)
  dateOfBirth DateTime? @db.Date

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade) // ON DELETE CASCADE
  class Class? @relation(fields: [classId], references: [id]) // ON DELETE RESTRICT

  schedules              Schedule[]
  scheduleExceptions     ScheduleException[]
  freeTimes              FreeTime[]
  conductScores          ConductScore[]
  attendanceRecords      AttendanceRecord[]
  attendanceScanRequests AttendanceScanRequest[]
  eventRegistrations     EventRegistration[]
  attendanceAppeals      AttendanceAppeal[]
  attendanceAppealAttempts AttendanceAppealAttempt[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([classId])
  @@map("students")
}
