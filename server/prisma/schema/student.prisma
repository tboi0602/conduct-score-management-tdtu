// ============================================================

// Hồ sơ sinh viên, liên kết 1-1 với tài khoản User
model Student {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @unique @db.Uuid
  classId     String? @db.Uuid
  studentCode String @unique @db.VarChar(20) // MSSV

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade) // ON DELETE CASCADE
  class Class? @relation(fields: [classId], references: [id]) // ON DELETE RESTRICT

  schedules         Schedule[]
  freeTimes         FreeTime[]
  trainingPoints    TrainingPoint[]
  attendanceRecords AttendanceRecord[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([classId])
  @@map("students")
}
