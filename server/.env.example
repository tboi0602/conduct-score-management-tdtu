# ---------- Application ----------
# Environment: development | test | production
NODE_ENV=<environment>
API_PORT=<api-port>
WORKER_REPLICAS=<worker-replica-count>
WORKER_HEALTH_PORT=<worker-health-port>
# Logging level: debug | info | warn | error
LOG_LEVEL=<log-level>

# ---------- PostgreSQL ----------
POSTGRES_DB=<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<strong-database-password>
POSTGRES_PORT=<database-port>
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>
DATABASE_URL=<postgresql-connection-url>

# ---------- Redis ----------
REDIS_PASSWORD=<strong-redis-password>
REDIS_PORT=<redis-host-port>
# Format: redis://:<password>@<host>:<port>
# Với Docker Compose, host là `redis` và cổng nội bộ là `6379`.
REDIS_URL=<redis-connection-url>
# TTL values use seconds unless the variable name ends in _MS.
REDIS_IDEMPOTENCY_TTL=<idempotency-ttl-seconds>
REDIS_LOCK_TTL_MS=<distributed-lock-ttl-milliseconds>
REDIS_CACHE_TTL=<cache-ttl-seconds>
REDIS_RATE_LIMIT_WINDOW=<rate-limit-window-seconds>
REDIS_RATE_LIMIT_MAX=<maximum-requests-per-window>

# ---------- RabbitMQ ----------
# Format: amqp://<user>:<password>@<host>:<port>/<virtual-host>
RABBITMQ_URL=<rabbitmq-connection-url>
RABBITMQ_USER=<rabbitmq-user>
RABBITMQ_PASSWORD=<strong-rabbitmq-password>
RABBITMQ_VHOST=<rabbitmq-virtual-host>
RABBITMQ_PORT=<rabbitmq-port>
RABBITMQ_MGMT_PORT=<rabbitmq-management-port>
RABBITMQ_EXCHANGE=<training-point-exchange-name>
RABBITMQ_PREFETCH=<messages-per-worker>
RABBITMQ_MAX_RETRIES=<maximum-message-retries>
RABBITMQ_RETRIES=<connection-retry-count>

# ---------- Nginx ----------
NGINX_PORT=<http-port>
NGINX_TLS_PORT=<https-port>

# ---------- Web client ----------
NEXT_PUBLIC_API_BASE_URL=<public-api-base-url>
NEXT_PUBLIC_APP_URL=<public-application-url>

# ---------- Attendance geofencing ----------
GEOFENCE_MAX_DISTANCE_METERS=<maximum-distance-from-event-in-meters>
GEOFENCE_MAX_GPS_ERROR_METERS=<maximum-accepted-gps-error-in-meters>

# ---------- Conduct rule engine ----------
RULE_ABSENT_STREAK_WARN=<consecutive-absence-warning-threshold>
RULE_ABSENCE_RATE_WARN_PCT=<absence-rate-warning-percentage>

# ---------- Application authentication ----------
# Use a long, cryptographically random value. Required in production.
JWT_SECRET=<long-random-jwt-secret>
# Examples: 30m, 8h, 1d
JWT_EXPIRES_IN=<access-token-lifetime>
# Examples: 7d, 30d, 90d
JWT_REFRESH_EXPIRES_IN=<refresh-token-lifetime>

# OAuth 2.0 Web Client ID created in Google Cloud Console.
GOOGLE_CLIENT_ID=<google-oauth-web-client-id>

# ---------- Monitoring ----------
PROMETHEUS_PORT=<prometheus-port>
GRAFANA_PORT=<grafana-port>
GRAFANA_ADMIN_USER=<grafana-admin-user>
GRAFANA_ADMIN_PASSWORD=<strong-grafana-admin-password>
